---
---
<footer style="border-top:1px solid var(--border-color); background:var(--bg-elevated); padding:48px 24px 32px; font-family:'Geist',Arial,sans-serif; color:var(--text-body); transition:background-color 0.2s, border-color 0.2s;">
  <div style="max-width:1100px; margin:0 auto; display:flex; flex-direction:column; gap:32px;">
    
    <!-- Top Footer row -->
    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:32px;">
      <!-- Brand column -->
      <div style="max-width:340px;">
        <div style="display:flex; align-items:center; gap:8px; font-weight:600; font-size:16px; color:var(--text-ink); margin-bottom:12px;">
          <span style="width:24px; height:24px; border-radius:4px; background:var(--text-ink); color:var(--bg-page); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;">B64</span>
          ImageToBase64.dpdns.org
        </div>
        <p style="margin:0; font-size:13px; color:var(--text-mute); line-height:1.6;">
          Free, 100% browser-based tool to convert images to base64 encoding and decode base64 strings back to images. Zero server uploads, instant processing, absolute privacy.
        </p>
      </div>

      <!-- Quick Links -->
      <div style="display:flex; gap:48px; flex-wrap:wrap;">
        <div>
          <h4 style="margin:0 0 12px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-ink);">Tools</h4>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; font-size:13px;">
            <li><a href="/" style="color:var(--text-body); text-decoration:none;">Image to Base64</a></li>
            <li><a href="/#faq" style="color:var(--text-body); text-decoration:none;">Base64 FAQ</a></li>
          </ul>
        </div>

        <div>
          <h4 style="margin:0 0 12px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-ink);">Company</h4>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; font-size:13px;">
            <li><a href="/about" style="color:var(--text-body); text-decoration:none;">About Us</a></li>
            <li><a href="/contact" style="color:var(--text-body); text-decoration:none;">Contact Us</a></li>
          </ul>
        </div>

        <div>
          <h4 style="margin:0 0 12px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-ink);">Legal</h4>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; font-size:13px;">
            <li><a href="/privacy" style="color:var(--text-body); text-decoration:none;">Privacy Policy</a></li>
            <li><a href="/terms" style="color:var(--text-body); text-decoration:none;">Terms &amp; Conditions</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div style="border-top:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; font-size:12px; color:var(--text-mute); padding-top:20px;">
      <span>&copy; {new Date().getFullYear()} ImageToBase64.dpdns.org. All rights reserved.</span>
      <span>Supports PNG, JPEG, WebP, SVG, GIF, BMP, ICO, TIFF, AVIF, HEIC</span>
    </div>

  </div>
</footer>
