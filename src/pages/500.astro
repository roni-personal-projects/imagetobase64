---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="500 — Server Error | ImageToBase64.dpdns.org"
	description="An unexpected error occurred on the server."
	canonical="https://www.imagetobase64.dpdns.org/500"
>
	<main style="max-width:600px; margin:0 auto; padding:96px 24px 128px; text-align:center; font-family:'Geist',Arial,sans-serif;">
		<div style="font-family:monospace; font-size:14px; font-weight:600; color:#ee0000; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:12px;">
			Error 500
		</div>
		<h1 style="font-size:40px; font-weight:600; color:var(--text-ink); letter-spacing:-1.2px; margin:0 0 16px;">
			Internal Server Error
		</h1>
		<p style="font-size:16px; color:var(--text-body); margin:0 0 32px; line-height:1.6;">
			An unexpected error occurred. Please try refreshing the page or return to the converter homepage.
		</p>
		<a href="/" style="display:inline-flex; align-items:center; justify-content:center; padding:12px 24px; background:var(--text-ink); color:var(--bg-page); text-decoration:none; border-radius:9999px; font-size:14px; font-weight:500;">
			Back to Home &rarr;
		</a>
	</main>
</Layout>
